\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Scoped matrix. States are coded; see the character-state list. Missingness is never collapsed: \texttt  {--} no row entered, \texttt  {.NR} not recorded in the source, \texttt  {.IL} illegible, \texttt  {.NA} inapplicable, \texttt  {0} an observed absence.}}{1}{table.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The comparative reading, printed with full values and no state codes. \texttt  {PR1} takes both values \emph  {inside} \texttt  {MC1=pooling} at a fixed date, so ex-ante pricing is a separate axis rather than a stage of mechanism; \texttt  {PY0} separates the forms on whether a draw corresponds to the recipient's own realised loss.}}{2}{table.2}\protected@file@percent }
